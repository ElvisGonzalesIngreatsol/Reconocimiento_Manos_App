<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleccione el Modo de Reconocimiento:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerModos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnAccionPrincipal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Procesar"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnAlternarModo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ocultar Cuadros"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnLimpiarEscaneo"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Limpiar Escaneo"
        android:textColor="#FF3333"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/txtContadorFotos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fotos procesadas: 0 / 0"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginBottom="12dp"
        android:gravity="center" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Previsualización" />

        <androidx.camera.view.PreviewView
            android:id="@+id/previewViewCameraX"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.ingreatsol.reconocimiento_manos_python.ResaltadorView
            android:id="@+id/resaltadorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btnAnteriorFoto"
            android:layout_width="48dp"
            android:layout_height="64dp"
            android:layout_gravity="left|center_vertical"
            android:text="&lt;"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#80000000"
            android:padding="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSiguienteFoto"
            android:layout_width="48dp"
            android:layout_height="64dp"
            android:layout_gravity="right|center_vertical"
            android:text="&gt;"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#80000000"
            android:padding="0dp"
            android:visibility="gone" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seleccione un modo para comenzar..."
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/txtResultadoSuma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consolidado pendiente..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0066CC" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>